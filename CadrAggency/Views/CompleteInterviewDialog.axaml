<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CadrAggency.ViewModels"
        xmlns:conv="clr-namespace:CadrAggency.Converters"
        x:Class="CadrAggency.Views.CompleteInterviewDialog"
        x:DataType="vm:CompleteInterviewDialogViewModel"
        x:CompileBindings="False"
        Title="Завершение собеседования"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <ScrollViewer DockPanel.Dock="Top" Height="300">
            <StackPanel Spacing="12">

                <TextBlock Text="{Binding HeaderText}"
                           FontSize="14" FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Результат:" Width="130" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Results}"
                              SelectedItem="{Binding Result}"
                              Width="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDescriptionConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Комментарий:" Width="130" VerticalAlignment="Top"/>
                    <TextBox Text="{Binding Comment}" Width="300" Height="120"
                             AcceptsReturn="True"
                             Watermark="Сильные и слабые стороны, рекомендации..."/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="10">
            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                    Background="Green" Foreground="White" Width="120"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Background="Red" Foreground="White" Width="120"/>
        </StackPanel>
    </DockPanel>
</Window>


