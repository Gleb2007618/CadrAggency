<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CadrAggency.ViewModels"
        xmlns:conv="clr-namespace:CadrAggency.Converters"
        x:Class="CadrAggency.Views.ScheduleInterviewDialog"
        x:DataType="vm:ScheduleInterviewDialogViewModel"
        x:CompileBindings="False"
        Title="Назначение собеседования"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <ScrollViewer DockPanel.Dock="Top" Height="400">
            <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Соискатель:" Width="130" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Candidates}"
                              SelectedItem="{Binding SelectedCandidate}"
                              Width="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Вакансия:" Width="130" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Vacancies}"
                              SelectedItem="{Binding SelectedVacancy}"
                              Width="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Дата:" Width="130" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ScheduledDate}" Width="300"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Время:" Width="130" VerticalAlignment="Center"/>
                    <TimePicker SelectedTime="{Binding ScheduledTime}" Width="300"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Формат:" Width="130" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding Format}"
                              Width="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDescriptionConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Комментарий:" Width="130" VerticalAlignment="Top"/>
                    <TextBox Text="{Binding Comment}" Width="300" Height="80" AcceptsReturn="True"
                             Watermark="Ссылка на звонок, адрес офиса и т.п."/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="10">
            <Button Content="Назначить" Command="{Binding SaveCommand}"
                    Background="Green" Foreground="White" Width="120"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Background="Red" Foreground="White" Width="120"/>
        </StackPanel>
    </DockPanel>
</Window>

