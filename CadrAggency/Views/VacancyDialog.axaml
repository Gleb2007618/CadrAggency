<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CadrAggency.ViewModels"
        xmlns:conv="clr-namespace:CadrAggency.Converters"
        x:Class="CadrAggency.Views.VacancyDialog"
        x:DataType="vm:VacancyDialogViewModel"
        x:CompileBindings="False"
        Title="{Binding WindowTitle}"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <ScrollViewer DockPanel.Dock="Top" Height="500">
            <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Название:" Width="130" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Title}" Width="300"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Описание:" Width="130" VerticalAlignment="Top"/>
                    <TextBox Text="{Binding Description}" Width="300" Height="80" AcceptsReturn="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Требования:" Width="130" VerticalAlignment="Top"/>
                    <TextBox Text="{Binding Requirements}" Width="300" Height="80" AcceptsReturn="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Зарплата:" Width="130" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding Salary}" Width="300" Increment="1000" Minimum="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Статус:" Width="130" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding Status}"
                              Width="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDescriptionConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Дата размещения:" Width="130" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding PostedDate}" Width="300"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="10">
            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                    Background="Green" Foreground="White" Width="110"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Background="Red" Foreground="White" Width="110"/>
        </StackPanel>
    </DockPanel>
</Window>


