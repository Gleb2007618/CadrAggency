<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CadrAggency.ViewModels"
        x:Class="CadrAggency.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        x:CompileBindings="False"
        Title="Подтверждение"
        Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="15">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   DockPanel.Dock="Top"
                   Margin="0,10,0,20"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Да" Command="{Binding YesCommand}" Background="Red" Foreground="White" Width="90"/>
            <Button Content="Нет" Command="{Binding NoCommand}" Width="90"/>
        </StackPanel>
    </DockPanel>
</Window>

